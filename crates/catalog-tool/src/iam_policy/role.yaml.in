AWSTemplateFormatVersion: "2010-09-09"
Description: >-
  Cross-account read-only IAM role assumed by aws-inventory. Generated by
  catalog-tool iam-policy from callable catalog plans. Deploy in each account.
  Requires @POLICY_COUNT@ managed-policy attachments; IAM role quota is 20 by default,
  25 maximum on request (AWS IAM quotas, verified 2026-11-24).

Parameters:
  TrustedPrincipalArn:
    Type: String
    Description: >-
      IAM role ARN (not an assumed-role session ARN) in the account that runs
      aws-inventory. That principal must also hold sts:AssumeRole for this role.
    AllowedPattern: '^arn:aws[a-zA-Z-]*:iam::[0-9]{12}:(role|user)/[A-Za-z0-9_+=,.@/-]+$'
    ConstraintDescription: must be an IAM role or user ARN such as arn:aws:iam::123456789012:role/InventoryRunner

  ExternalId:
    Type: String
    NoEcho: true
    Description: Shared secret required in the trust policy. Export the same value to the tool's external ID variable.
    MinLength: 2
    MaxLength: 1224
    AllowedPattern: '^[A-Za-z0-9_+=,.@:/-]+$'
    ConstraintDescription: '2-1224 characters from A-Z a-z 0-9 _ + = , . @ : / -'

  RoleName:
    Type: String
    Default: aws-inventory-read-only
    Description: Role name in every scanned account. Must match --organization-role when scanning an Organization.
    MinLength: 1
    MaxLength: 64
    AllowedPattern: '^[A-Za-z0-9_+=,.@-]+$'
    ConstraintDescription: 1-64 characters from A-Z a-z 0-9 _ + = , . @ -

Resources:
@POLICIES@

  InventoryReadOnlyRole:
    Type: AWS::IAM::Role
    Properties:
      RoleName: !Ref RoleName
      Description: Read-only role assumed by aws-inventory from TrustedPrincipalArn.
      AssumeRolePolicyDocument:
        Version: "2012-10-17"
        Statement:
          - Effect: Allow
            Principal:
              AWS: !Ref TrustedPrincipalArn
            Action: sts:AssumeRole
            Condition:
              StringEquals:
                sts:ExternalId: !Ref ExternalId
      ManagedPolicyArns:
@ATTACHMENTS@

Outputs:
  RoleArn:
    Description: Pass to aws-inventory scan --role-arn for a single account.
    Value: !GetAtt InventoryReadOnlyRole.Arn
