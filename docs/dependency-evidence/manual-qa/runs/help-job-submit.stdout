Persist a scan specification without loading credentials or making AWS calls

Usage: aws-inventory job submit [OPTIONS]

Options:
      --queue <QUEUE>
          [default: jobs.sqlite]
      --job-id <JOB_ID>
          
      --max-job-attempts <MAX_JOB_ATTEMPTS>
          [default: 3]
      --delay-seconds <DELAY_SECONDS>
          [default: 0]
      --db <DB>
          [default: inventory.sqlite]
      --profile <PROFILE>
          
      --region <REGION>
          
      --service <SERVICE>
          [default: all]
      --config-aggregator <CONFIG_AGGREGATOR>
          
      --resource-explorer-view <RESOURCE_EXPLORER_VIEW>
          
      --discover-sources
          Discover existing Config/Explorer sources in selected regions; ambiguity stays explicit
      --organization-role <ORGANIZATION_ROLE>
          Enumerate ACTIVE Organizations accounts and assume this existing role in each
      --role-arn <ROLE_ARN>
          Assume an explicitly named existing role before resolving the target account
      --account-id <ACCOUNT_ID>
          Restrict Organizations collection to these exact account IDs
      --external-id-env <EXTERNAL_ID_ENV>
          Environment variable containing an optional STS external ID; its value is not persisted
      --role-session-name <ROLE_SESSION_NAME>
          [default: aws-inventory]
      --role-duration-seconds <ROLE_DURATION_SECONDS>
          [default: 3600]
      --max-accounts <MAX_ACCOUNTS>
          Fail before scanning when the selected account set exceeds this bound [default: 128]
      --cloud-control
          Add the catalog of regional Cloud Control list/read resource types
      --resource-type <RESOURCE_TYPE>
          CloudFormation type names; empty selects the full Cloud Control catalog
      --concurrency <CONCURRENCY>
          [default: 128]
      --per-bucket-concurrency <PER_BUCKET_CONCURRENCY>
          [default: 4]
      --rps <RPS>
          Conservative initial request-start ceiling per account/region/service bucket [default: 5]
      --attempts <ATTEMPTS>
          [default: 5]
      --max-pages <MAX_PAGES>
          [default: 10000]
      --page-size <PAGE_SIZE>
          [default: 100]
      --rate-policy <RATE_POLICY>
          JSON map of exact quota-bucket keys to integer or requests/period rate policies
      --output-dir <OUTPUT_DIR>
          Export each finalized scan into a new attempt directory under this path
      --export-format <EXPORT_FORMAT>
          [default: jsonl] [possible values: json, jsonl]
      --provenance <PROVENANCE>
          [default: normalized] [possible values: normalized, all-observations]
      --falkor
          Also build and push a replayable FalkorDB plan; requires an output directory
      --falkor-url-env <FALKOR_URL_ENV>
          [default: FALKORDB_URL]
      --graph <GRAPH>
          [default: aws_inventory]
      --delivery-attempts <DELIVERY_ATTEMPTS>
          [default: 5]
      --delivery-timeout-seconds <DELIVERY_TIMEOUT_SECONDS>
          Bound each scan's full export/delivery operation, including retry backoff [default: 900]
      --allow-partial
          Include finalized partial/cancelled snapshots with their actual status
  -h, --help
          Print help
