digraph G {
  graph [bgcolor="#fcfcfb", fontname="Inter", fontsize=17, fontcolor="#0b0b0b",
         label=<<table border="0" cellborder="0" cellspacing="0"><tr><td align="left"><b>When a resource is deleted from the inventory</b></td></tr><tr><td height="6"></td></tr></table>>, labelloc=t, labeljust=l, pad=0.35,
         rankdir=LR, nodesep=0.35, ranksep=0.6, newrank=true ];
  node [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#c3c2b7",
        penwidth=1.2, fontname="Inter", fontsize=12, fontcolor="#0b0b0b",
        margin="0.17,0.10"];
  edge [color="#52514e", arrowsize=0.7, penwidth=1.1, fontname="Inter",
        fontsize=10, fontcolor="#52514e"];

  present [label="Present", fillcolor="#dceafb", color="#86b6ef"];
  m1 [label="Missing from one\ncomplete listing", fillcolor="#ffffff", color="#c3c2b7"];
  gone [label="Deleted\nrow, edges and children removed", fillcolor="#fbe0e0", color="#d03b3b"];
  present -> m1 [label="complete listing,\nnot in it"];
  m1 -> gone [label="second complete listing,\nstill not in it"];
  m1 -> present [label="seen again", constraint=false];
  nochange [label="Partial, denied, failed or throttled listing:\nnothing changes", fillcolor="#d9f2e8", color="#1baf7a"];
  present -> nochange [style=dashed, dir=none];
  {rank=same; present; nochange}
}
