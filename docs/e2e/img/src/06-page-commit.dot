digraph G {
  graph [bgcolor="#fcfcfb", fontname="Inter", fontsize=17, fontcolor="#0b0b0b",
         label=<<table border="0" cellborder="0" cellspacing="0"><tr><td align="left"><b>One page, one transaction</b></td></tr><tr><td height="6"></td></tr></table>>, labelloc=t, labeljust=l, pad=0.35,
         rankdir=LR, nodesep=0.35, ranksep=0.5, newrank=true ];
  node [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#c3c2b7",
        penwidth=1.2, fontname="Inter", fontsize=12, fontcolor="#0b0b0b",
        margin="0.17,0.10"];
  edge [color="#52514e", arrowsize=0.7, penwidth=1.1, fontname="Inter",
        fontsize=10, fontcolor="#52514e"];

  page [label="One decoded page", fillcolor="#dceafb", color="#86b6ef"];
  subgraph cluster_tx {
    label=<<font point-size="11" color="#52514e">committed together, or not at all</font>>;
    style="rounded,dashed"; color="#c3c2b7"; fontname="Inter";
    r [label="Changed resource rows\nand typed columns", shape=cylinder, fillcolor="#fdf0d5", color="#d9a531", margin="0.14,0.12"];
    ed [label="Changed edges", shape=cylinder, fillcolor="#fdf0d5", color="#d9a531", margin="0.14,0.12"];
    pa [label="Parent links and\nlisting membership", shape=cylinder, fillcolor="#fdf0d5", color="#d9a531", margin="0.14,0.12"];
    ev [label="Evidence of what\nthis page saw", shape=cylinder, fillcolor="#fdf0d5", color="#d9a531", margin="0.14,0.12"];
    ob [label="Keys for the\ngraph projection", shape=cylinder, fillcolor="#fdf0d5", color="#d9a531", margin="0.14,0.12"];
    wq [label="Queue position: next token,\nor done plus child work", shape=cylinder, fillcolor="#fdf0d5", color="#d9a531", margin="0.14,0.12"];
  }
  unchanged [label="Unchanged records:\nnothing is written", fillcolor="#ffffff", color="#c3c2b7"];
  page -> r; page -> ed; page -> pa; page -> ev; page -> ob; page -> wq;
  page -> unchanged [style=dashed];
}
