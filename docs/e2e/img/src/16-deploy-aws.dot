digraph G {
  graph [bgcolor="#fcfcfb", fontname="Inter", fontsize=17, fontcolor="#0b0b0b",
         label=<<table border="0" cellborder="0" cellspacing="0"><tr><td align="left"><b>Running in AWS (after version 1)</b></td></tr><tr><td height="6"></td></tr></table>>, labelloc=t, labeljust=l, pad=0.35,
         rankdir=LR, nodesep=0.35, ranksep=0.6, newrank=true ];
  node [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#c3c2b7",
        penwidth=1.2, fontname="Inter", fontsize=12, fontcolor="#0b0b0b",
        margin="0.17,0.10"];
  edge [color="#52514e", arrowsize=0.7, penwidth=1.1, fontname="Inter",
        fontsize=10, fontcolor="#52514e"];

  subgraph cluster_c {
    label=<<font point-size="11" color="#52514e">the customer's own AWS account (default, not yet confirmed)</font>>;
    style="rounded,dashed"; color="#c3c2b7";
    sch [label="Schedule", fillcolor="#f0efec", color="#c3c2b7"];
    task [label="Fargate task\nthe same collector binary", fillcolor="#dceafb", color="#86b6ef"];
    pg [label="Managed PostgreSQL", shape=cylinder, fillcolor="#fdf0d5", color="#d9a531", margin="0.14,0.12"];
    g [label="Graph database\nNeptune as an option", shape=cylinder, fillcolor="#fdf0d5", color="#d9a531", margin="0.14,0.12"];
    sch -> task -> pg; task -> g;
  }
  mem [label="Member accounts\nread-only role in each", fillcolor="#f0efec", color="#c3c2b7"];
  app [label="Desktop app\non a laptop", fillcolor="#fbe3ec", color="#e87ba4"];
  task -> mem [label="assume role,\nread only"];
  app -> pg [label="reader role"]; app -> g;
  later [label="Later: Lambda fan-out,\none slice per account and region", fillcolor="#ffffff", color="#c3c2b7"];
  task -> later [style=dashed, dir=none];
}
