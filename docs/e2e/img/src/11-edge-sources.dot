digraph G {
  graph [bgcolor="#fcfcfb", fontname="Inter", fontsize=17, fontcolor="#0b0b0b",
         label=<<table border="0" cellborder="0" cellspacing="0"><tr><td align="left"><b>Where an edge comes from</b></td></tr><tr><td height="6"></td></tr></table>>, labelloc=t, labeljust=l, pad=0.35,
         rankdir=LR, nodesep=0.35, ranksep=0.6, newrank=true ];
  node [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#c3c2b7",
        penwidth=1.2, fontname="Inter", fontsize=12, fontcolor="#0b0b0b",
        margin="0.17,0.10"];
  edge [color="#52514e", arrowsize=0.7, penwidth=1.1, fontname="Inter",
        fontsize=10, fontcolor="#52514e"];

  a [label="The API model\nreference traits", shape=note, fillcolor="#fdf0d5", color="#d9a531"];
  b [label="Reviewed rules\n968 carried over", shape=note, fillcolor="#fdf0d5", color="#d9a531"];
  c [label="Inference\na field equals exactly one\ncollected ARN or ID", fillcolor="#dceafb", color="#86b6ef"];
  e [label="edges\neach row says which source", shape=cylinder, fillcolor="#fdf0d5", color="#d9a531", margin="0.14,0.12"];
  amb [label="More than one match:\ncounted, not drawn", fillcolor="#ffffff", color="#c3c2b7"];
  late [label="Target not collected yet:\nkept unresolved, drawn when it arrives", fillcolor="#ffffff", color="#c3c2b7"];
  a -> e [label="declared"]; b -> e [label="rule"]; c -> e [label="inferred"];
  c -> amb [style=dashed]; c -> late [style=dashed];
  n [shape=plain, label=<<font point-size="10" color="#52514e">An ARN matches anywhere. A bare ID matches only inside its own account and region.<br/>When a match stops being unique, the edge is withdrawn.</font>>];
  e -> n [style=invis];
}
