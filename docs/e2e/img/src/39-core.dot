digraph G {
  graph [bgcolor="#fcfcfb", fontname="Inter", fontsize=17, fontcolor="#0b0b0b",
         label=<<table border="0" cellborder="0" cellspacing="0"><tr><td align="left"><b>The core, in five parts</b></td></tr><tr><td align="left"><font point-size="10" color="#52514e">Everything else in the design serves one of these.</font></td></tr><tr><td height="6"></td></tr></table>>, labelloc=t, labeljust=l, pad=0.35,
         rankdir=TB, nodesep=0.35, ranksep=0.35, newrank=true ];
  node [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#c3c2b7",
        penwidth=1.2, fontname="Inter", fontsize=12, fontcolor="#0b0b0b",
        margin="0.17,0.10"];
  edge [color="#52514e", arrowsize=0.7, penwidth=1.1, fontname="Inter",
        fontsize=10, fontcolor="#52514e"];

  cat [label="1  Catalog\nAWS's own API models, compiled. A deny list and an overlay per service\ndecide what may be called. Services are data, never code", shape=note, fillcolor="#fdf0d5", color="#d9a531"];
  col [label="2  Collector\nEvery account, region and service at once, each at the rate AWS allows.\nOne engine signs, pages and decodes every protocol into binary records", fillcolor="#dceafb", color="#86b6ef"];
  pg [label="3  PostgreSQL: the truth\nOne table per kind with typed columns. A record is hashed and written only if it changed.\nThe work queue lives here too, so a kill loses nothing", shape=cylinder, fillcolor="#fdf0d5", color="#d9a531", margin="0.14,0.12"];
  gr [label="4  Graph engine: a copy\nResources and edges, rebuilt from SQL at any time. Answers neighbours, paths, blast radius", shape=cylinder, fillcolor="#fdf0d5", color="#d9a531", margin="0.14,0.12"];
  app [label="5  Desktop app\nReads both directly. Tables, SQL, sweep control,\nand the whole account drawn at 120 frames a second", fillcolor="#fbe3ec", color="#e87ba4"];
  cat -> col -> pg -> gr -> app;
  pg -> app [constraint=false];
}
