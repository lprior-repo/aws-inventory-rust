digraph G {
  graph [bgcolor="#fcfcfb", fontname="Inter", fontsize=17, fontcolor="#0b0b0b",
         label=<<table border="0" cellborder="0" cellspacing="0"><tr><td align="left"><b>Inside the desktop app</b></td></tr><tr><td align="left"><table border="0" cellborder="0" cellspacing="4"><tr><td bgcolor="#fbe3ec" width="13" height="13" border="1" color="#e87ba4" fixedsize="true"></td><td align="left"><font point-size="10" color="#52514e">desktop app&#160;&#160;&#160;</font></td><td bgcolor="#dceafb" width="13" height="13" border="1" color="#86b6ef" fixedsize="true"></td><td align="left"><font point-size="10" color="#52514e">our code&#160;&#160;&#160;</font></td><td bgcolor="#fdf0d5" width="13" height="13" border="1" color="#d9a531" fixedsize="true"></td><td align="left"><font point-size="10" color="#52514e">data we keep&#160;&#160;&#160;</font></td><td bgcolor="#f0efec" width="13" height="13" border="1" color="#c3c2b7" fixedsize="true"></td><td align="left"><font point-size="10" color="#52514e">outside the product&#160;&#160;&#160;</font></td></tr></table></td></tr><tr><td height="6"></td></tr></table>>, labelloc=t, labeljust=l, pad=0.35,
         rankdir=LR, nodesep=0.35, ranksep=0.6, newrank=true ];
  node [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#c3c2b7",
        penwidth=1.2, fontname="Inter", fontsize=12, fontcolor="#0b0b0b",
        margin="0.17,0.10"];
  edge [color="#52514e", arrowsize=0.7, penwidth=1.1, fontname="Inter",
        fontsize=10, fontcolor="#52514e"];

  subgraph cluster_ui {
    label=<<font point-size="11" color="#52514e">UI thread: one frame per display refresh</font>>;
    style="rounded,dashed"; color="#c3c2b7";
    w [label="Widgets\ntable, graph, console, panels", fillcolor="#fbe3ec", color="#e87ba4"];
  }
  subgraph cluster_wk {
    label=<<font point-size="11" color="#52514e">Worker thread: everything slow</font>>;
    style="rounded,dashed"; color="#c3c2b7";
    q [label="Queries and SQL", fillcolor="#dceafb", color="#86b6ef"];
    l [label="Account load,\nlayout, GPU buffers", fillcolor="#dceafb", color="#86b6ef"];
    s [label="Sweep", fillcolor="#dceafb", color="#86b6ef"];
    t [label="Traversal", fillcolor="#dceafb", color="#86b6ef"];
  }
  pg [label="PostgreSQL", shape=cylinder, fillcolor="#fdf0d5", color="#d9a531", margin="0.14,0.12"];
  g [label="Graph database", shape=cylinder, fillcolor="#fdf0d5", color="#d9a531", margin="0.14,0.12"];
  aws [label="AWS\nor the emulator", fillcolor="#f0efec", color="#c3c2b7"];
  w -> q [label="commands\n(bounded)"]; w -> l; w -> s; w -> t;
  q -> w [label="events\n(bounded)", constraint=false, style=dashed];
  q -> pg [label="reader role"]; l -> pg [label="reader role"];
  s -> pg [label="collector role"]; s -> aws [label="read only"];
  t -> g;
}
