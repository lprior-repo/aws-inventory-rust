digraph G {
  graph [bgcolor="#fcfcfb", fontname="Inter", fontsize=17, fontcolor="#0b0b0b",
         label=<<table border="0" cellborder="0" cellspacing="0"><tr><td align="left"><b>The whole system, end to end</b></td></tr><tr><td align="left"><table border="0" cellborder="0" cellspacing="4"><tr><td bgcolor="#dceafb" width="13" height="13" border="1" color="#86b6ef" fixedsize="true"></td><td align="left"><font point-size="10" color="#52514e">our code&#160;&#160;&#160;</font></td><td bgcolor="#fdf0d5" width="13" height="13" border="1" color="#d9a531" fixedsize="true"></td><td align="left"><font point-size="10" color="#52514e">data we keep&#160;&#160;&#160;</font></td><td bgcolor="#f0efec" width="13" height="13" border="1" color="#c3c2b7" fixedsize="true"></td><td align="left"><font point-size="10" color="#52514e">outside the product&#160;&#160;&#160;</font></td><td bgcolor="#fbe3ec" width="13" height="13" border="1" color="#e87ba4" fixedsize="true"></td><td align="left"><font point-size="10" color="#52514e">desktop app&#160;&#160;&#160;</font></td></tr></table></td></tr><tr><td height="6"></td></tr></table>>, labelloc=t, labeljust=l, pad=0.35,
         rankdir=TB, nodesep=0.4, ranksep=0.5, newrank=true ];
  node [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#c3c2b7",
        penwidth=1.2, fontname="Inter", fontsize=12, fontcolor="#0b0b0b",
        margin="0.17,0.10"];
  edge [color="#52514e", arrowsize=0.7, penwidth=1.1, fontname="Inter",
        fontsize=10, fontcolor="#52514e"];

  models [label="AWS API models\n436 services, pinned", shape=note, fillcolor="#fdf0d5", color="#d9a531"];
  overlay [label="Overlay and deny list\none file per service", shape=note, fillcolor="#fdf0d5", color="#d9a531"];
  compiler [label="Catalog compiler", fillcolor="#dceafb", color="#86b6ef"];
  catalog [label="Binary catalog\nwhat may be called, and how", shape=note, fillcolor="#fdf0d5", color="#d9a531"];
  planner [label="Planner", fillcolor="#dceafb", color="#86b6ef"];
  queue [label="Work queue", shape=cylinder, fillcolor="#fdf0d5", color="#d9a531", margin="0.14,0.12"];
  executor [label="Executor\nrate limits, retries", fillcolor="#dceafb", color="#86b6ef"];
  wire [label="Wire engine\nsign, send, page, decode", fillcolor="#dceafb", color="#86b6ef"];
  aws [label="AWS\nor the emulator", fillcolor="#f0efec", color="#c3c2b7"];
  recon [label="Reconciler\nhash, compare, write changes", fillcolor="#dceafb", color="#86b6ef"];
  pg [label="PostgreSQL\ntyped tables, records, edges", shape=cylinder, fillcolor="#fdf0d5", color="#d9a531", margin="0.14,0.12"];
  proj [label="Graph projection", fillcolor="#dceafb", color="#86b6ef"];
  graphdb [label="Graph database\nFalkorDB now", shape=cylinder, fillcolor="#fdf0d5", color="#d9a531", margin="0.14,0.12"];
  view [label="Query layer", fillcolor="#dceafb", color="#86b6ef"];
  ui [label="Desktop app\ntables, SQL, whole-account graph", fillcolor="#fbe3ec", color="#e87ba4"];
  sql [label="psql and other\nSQL clients", fillcolor="#f0efec", color="#c3c2b7"];
  {rank=same; models; overlay}
  {rank=same; compiler; catalog}
  {rank=same; planner; queue; executor; wire; aws}
  {rank=same; recon; pg; proj; graphdb}
  {rank=same; view; ui; sql}
  models -> compiler; overlay -> compiler; compiler -> catalog;
  catalog -> planner;
  planner -> queue -> executor -> wire;
  wire -> aws [dir=both, label="read only"];
  wire -> recon;
  recon -> pg -> proj -> graphdb;
  recon -> queue [label="next page,\nchild work", style=dashed];
  pg -> view; graphdb -> view [label="traversal"];
  view -> ui;
  pg -> sql [label="reader role"];
  ui -> planner [label="start a sweep", style=dashed, constraint=false];
}
