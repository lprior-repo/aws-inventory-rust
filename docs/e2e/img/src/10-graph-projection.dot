digraph G {
  graph [bgcolor="#fcfcfb", fontname="Inter", fontsize=17, fontcolor="#0b0b0b",
         label=<<table border="0" cellborder="0" cellspacing="0"><tr><td align="left"><b>SQL is the truth; the graph is rebuilt from it</b></td></tr><tr><td align="left"><table border="0" cellborder="0" cellspacing="4"><tr><td bgcolor="#dceafb" width="13" height="13" border="1" color="#86b6ef" fixedsize="true"></td><td align="left"><font point-size="10" color="#52514e">our code&#160;&#160;&#160;</font></td><td bgcolor="#fdf0d5" width="13" height="13" border="1" color="#d9a531" fixedsize="true"></td><td align="left"><font point-size="10" color="#52514e">data we keep&#160;&#160;&#160;</font></td><td bgcolor="#d9f2e8" width="13" height="13" border="1" color="#1baf7a" fixedsize="true"></td><td align="left"><font point-size="10" color="#52514e">a check&#160;&#160;&#160;</font></td><td bgcolor="#fbe3ec" width="13" height="13" border="1" color="#e87ba4" fixedsize="true"></td><td align="left"><font point-size="10" color="#52514e">desktop app&#160;&#160;&#160;</font></td></tr></table></td></tr><tr><td height="6"></td></tr></table>>, labelloc=t, labeljust=l, pad=0.35,
         rankdir=TB, nodesep=0.35, ranksep=0.42, newrank=true ];
  node [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#c3c2b7",
        penwidth=1.2, fontname="Inter", fontsize=12, fontcolor="#0b0b0b",
        margin="0.17,0.10"];
  edge [color="#52514e", arrowsize=0.7, penwidth=1.1, fontname="Inter",
        fontsize=10, fontcolor="#52514e"];

  pg [label="PostgreSQL\nresources and edges", shape=cylinder, fillcolor="#fdf0d5", color="#d9a531", margin="0.14,0.12"];
  ob [label="Projection outbox\nchanged and deleted keys", shape=cylinder, fillcolor="#fdf0d5", color="#d9a531", margin="0.14,0.12"];
  pr [label="Projection\nidentity, name and edges only", fillcolor="#dceafb", color="#86b6ef"];
  g [label="Graph database\nFalkorDB now, Neptune later", shape=cylinder, fillcolor="#fdf0d5", color="#d9a531", margin="0.14,0.12"];
  ui [label="Desktop app\nneighbours, paths, blast radius", fillcolor="#fbe3ec", color="#e87ba4"];
  v [label="graph-verify\nkeys in SQL = keys in graph", fillcolor="#d9f2e8", color="#1baf7a"];
  rb [label="Rebuild or repair\nfrom SQL at any time", fillcolor="#dceafb", color="#86b6ef"];
  pg -> ob -> pr -> g -> ui;
  pg -> v [constraint=false]; g -> v [constraint=false];
  v -> rb [label="difference", style=dashed];
  rb -> g [style=dashed, constraint=false];
  {rank=same; ob; v}
  {rank=same; pr; rb}
}
