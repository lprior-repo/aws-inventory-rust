digraph G {
  graph [bgcolor="#fcfcfb", fontname="Inter", fontsize=17, fontcolor="#0b0b0b",
         label=<<table border="0" cellborder="0" cellspacing="0"><tr><td align="left"><b>How an AWS operation becomes callable</b></td></tr><tr><td align="left"><table border="0" cellborder="0" cellspacing="4"><tr><td bgcolor="#dceafb" width="13" height="13" border="1" color="#86b6ef" fixedsize="true"></td><td align="left"><font point-size="10" color="#52514e">our code&#160;&#160;&#160;</font></td><td bgcolor="#fdf0d5" width="13" height="13" border="1" color="#d9a531" fixedsize="true"></td><td align="left"><font point-size="10" color="#52514e">data we keep&#160;&#160;&#160;</font></td><td bgcolor="#d9f2e8" width="13" height="13" border="1" color="#1baf7a" fixedsize="true"></td><td align="left"><font point-size="10" color="#52514e">a check&#160;&#160;&#160;</font></td><td bgcolor="#fbe0e0" width="13" height="13" border="1" color="#d03b3b" fixedsize="true"></td><td align="left"><font point-size="10" color="#52514e">never called&#160;&#160;&#160;</font></td></tr></table></td></tr><tr><td height="6"></td></tr></table>>, labelloc=t, labeljust=l, pad=0.35,
         rankdir=TB, nodesep=0.35, ranksep=0.38, newrank=true ];
  node [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#c3c2b7",
        penwidth=1.2, fontname="Inter", fontsize=12, fontcolor="#0b0b0b",
        margin="0.17,0.10"];
  edge [color="#52514e", arrowsize=0.7, penwidth=1.1, fontname="Inter",
        fontsize=10, fontcolor="#52514e"];

  m [label="19,641 operations in the pinned models", shape=note, fillcolor="#fdf0d5", color="#d9a531"];
  deny [label="1. Deny list first: content, secrets, paid, mutating", fillcolor="#fbe0e0", color="#d03b3b"];
  cls [label="2. Classify: enumerate, expand, denied, unclassified", fillcolor="#dceafb", color="#86b6ef"];
  gen [label="3. Generate the overlay entry:\nscope, items, paging, identity", fillcolor="#dceafb", color="#86b6ef"];
  defer [label="Any part missing:\ndeferred, with the reason", fillcolor="#ffffff", color="#c3c2b7"];
  kind [label="4. Give it a kind and a SQL table name", fillcolor="#dceafb", color="#86b6ef"];
  cat [label="5. Binary catalog: a callable handle", shape=note, fillcolor="#fdf0d5", color="#d9a531"];
  probe [label="6. Emulator probe:\ndid it return a seeded resource?", fillcolor="#d9f2e8", color="#1baf7a"];
  cc [label="7. Cloud Control cross-check:\nsame identities?", fillcolor="#d9f2e8", color="#1baf7a"];
  real [label="8. Real account, later", fillcolor="#d9f2e8", color="#1baf7a"];
  m -> deny -> cls -> gen -> kind -> cat -> probe -> cc -> real;
  gen -> defer [style=dashed];
  {rank=same; gen; defer}
}
